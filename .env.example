# Documentation only. Do not put real values in this file.
# Manus injects MANUS_API_URL and MANUS_API_KEY at runtime.
MANUS_API_URL=
MANUS_API_KEY=

# DEFORT access values are configured through Manus protected Secrets.
DEFORT_ACCESS_CODE=replace-in-Manus-Secrets
DEFORT_VIP_ACCESS_CODE=replace-in-Manus-Secrets
DEFORT_SESSION_SECRET=generate-a-long-random-value-in-Manus-Secrets

# Optional local runtime port.
PORT=3000
